# Copy to .env and fill in. .env is gitignored.
#
# Both are required at build time: the app refuses to start without them, so a
# deployment always names the relay it uses rather than inheriting one.

# The relay this build sends and receives through. Run the reference relay
# (atsms-worker) yourself, or point at one you trust.
VITE_ATSMS_API_URL=

# The mailto: domain published in your at.atsms.inbox record — the delivery
# route every ATSMS implementation must support. It has to be a domain that
# actually receives ATSMS mail.
VITE_ATSMS_EMAIL_DOMAIN=
